{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/domain.tsbuildinfo",
    // DOM 타입을 빼서 window·document·localStorage 같은 브라우저 API를 쓰면 컴파일 오류가 나게 합니다.
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
