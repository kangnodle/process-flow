{
  "name": "process-flow-frontend",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @process-flow/web --",
    "build": "tsc -b && npm run build -w @process-flow/web",
    "preview": "npm run preview -w @process-flow/web --",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run catalog:check && npm run architecture:check && npm run tools:test && npm run format:check && npm run typecheck && npm run lint && npm run test",
    "catalog:generate": "node ../tools/catalog/generate.mjs",
    "catalog:check": "node ../tools/catalog/generate.mjs --check",
    "architecture:check": "node ../tools/architecture/check.mjs",
    "tools:test": "node --test ../tools/catalog/*.test.mjs ../tools/architecture/*.test.mjs ../tools/launchers/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
